# 이 파일을 .env 로 복사한 뒤 값을 채우십시오. .env 는 절대 커밋하지 마십시오.
#   cp .env.example .env
# 검증:  git check-ignore -v .env   ← 무시된다고 나와야 정상

# ── KAMIS Open API ────────────────────────────────────────────────────
# https://www.kamis.or.kr/customer/reference/openapi_list.do
# 인증키와 '요청자 id' 두 개가 모두 필요합니다. id 가 없으면 인증 실패합니다.
KAMIS_KEY=
KAMIS_ID=

# ── 공공데이터포털 (data.go.kr) ────────────────────────────────────────
# ASOS 일자료 + 단기예보 통보문이 같은 키를 씁니다.
# 단, 서비스별로 '활용신청'을 따로 해야 합니다 (미승인 시 HTTP 403).
#   · 기상청_지상(종관, ASOS) 일자료 조회서비스
#   · 기상청_단기예보 통보문 조회서비스
# ★ 반드시 'Decoding' 키를 넣으십시오.
#   requests 가 파라미터를 자동 인코딩하므로 Encoding 키는 이중 인코딩되어 실패합니다.
DATA_GO_KR_KEY=

# ── 네이버 검색 API (뉴스) ─────────────────────────────────────────────
# https://developers.naver.com/apps → 애플리케이션 등록 → '검색' API 추가
# ⚠️ 네이버 클라우드 플랫폼(NCP)의 X-NCP-APIGW-* 자격증명은 쓸 수 없습니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── LLM 요약 (선택) ───────────────────────────────────────────────────
# 없으면 대시보드가 요약을 생략하고 나머지는 정상 동작합니다.
ANTHROPIC_API_KEY=

# ── Supabase (선택) ───────────────────────────────────────────────────
# 비우면 로컬 parquet 폴백으로 동작합니다.
# Supabase > Settings > API 에서 복사. anon 키를 쓰고 쓰기는 RLS 로 통제하십시오.
SUPABASE_URL=
SUPABASE_KEY=
